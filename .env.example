# Banco PostgreSQL local do Docker
POSTGRES_DB=ofertamestre
POSTGRES_USER=ofertamestre
# Gere um valor aleatorio; nao reutilize este exemplo em ambientes compartilhados.
POSTGRES_PASSWORD=replace-with-a-random-local-password

# URL usada pelo backend dentro do Docker Compose
DATABASE_URL=postgresql+psycopg://ofertamestre:replace-with-a-random-local-password@db:5432/ofertamestre

# Use uma string aleatoria com pelo menos 32 caracteres em qualquer ambiente real
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS do backend
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# URL da API usada no build do frontend
VITE_API_URL=http://localhost:8000

# Mercado Livre OAuth 2.0
# Configure apenas quando for testar a conexao OAuth.
# O redirect deve terminar em /oauth/mercadolivre/callback e bater exatamente com o app do Mercado Livre.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_TOKEN_ENCRYPTION_KEY=

# Steam official Web API
# Required only for Steam catalog discovery. Never commit a real key.
STEAM_WEB_API_KEY=
STEAM_WEB_API_BASE_URL=https://api.steampowered.com
STEAM_STORE_BASE_URL=https://store.steampowered.com
STEAM_APPDETAILS_ENABLED=false
STEAM_COUNTRY_CODE=br
STEAM_PRICE_CACHE_TTL_SECONDS=300
STEAM_PRICE_CACHE_MAX_ENTRIES=1000
